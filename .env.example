# ---------------------------------------------------------------------------
# Fantasy Rooting Agent - secrets
# Copy to .env  (NEVER commit .env)
# ---------------------------------------------------------------------------

# --- ESPN private leagues -------------------------------------------------
# Get these from a logged-in browser on fantasy.espn.com (see README).
ESPN_S2=
ESPN_SWID=

# --- Notifications --------------------------------------------------------
# Which provider to use: imessage | ntfy | telegram | console | twilio
NOTIFIER=console

# Option A: native iMessage (macOS only, Mac must be awake + signed into Messages)
IMESSAGE_TO=            # your iPhone number (+15551234567) or Apple ID email

# Option B: ntfy push (free, works anywhere)
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=             # SECRET: long random string, treat like a password
NTFY_TOKEN=             # optional, for authenticated/private ntfy servers
NTFY_USER=              # optional basic-auth user
NTFY_PASSWORD=          # optional basic-auth password

# Option C: Telegram bot (free)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Option E: Twilio (OPTIONAL, paid - not required for anything)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_TO=

# --- Behaviour ------------------------------------------------------------
TIMEZONE=America/Los_Angeles
NOTIFICATION_MINUTES_BEFORE=15
FANTASY_AGENT_HOME=     # defaults to ~/.fantasy-agent
LOG_LEVEL=INFO

# --- League Manager (autonomous roster management, one league) -----------
# See README.md "League Manager" for the full walkthrough.

# Anthropic API key for research + decisions. console.anthropic.com -> API Keys.
# pip install "fantasy-rooting-agent[league-manager]" first (anthropic + playwright).
ANTHROPIC_API_KEY=
# Optional: claude-sonnet-5 instead of the claude-opus-5 default, ~2.5x cheaper.
LEAGUE_MANAGER_MODEL=

# A SEPARATE Telegram bot from the rooting agent's, so league-management
# updates don't mix into the rooting feed. Same @BotFather flow as above.
LEAGUE_MANAGER_TELEGRAM_BOT_TOKEN=
LEAGUE_MANAGER_TELEGRAM_CHAT_ID=

# Only needed locally to point at a non-default captured Sleeper session -
# most setups don't need this (defaults to ~/.fantasy-agent/sleeper_session.json,
# produced by scripts/capture_sleeper_session.py). NEVER put a raw password here.
SLEEPER_SESSION_PATH=
